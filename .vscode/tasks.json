{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build game (debug)",
            "command": "${workspaceFolder}/buildgame",
            "args": [
                "-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build game (run)",
            "command": "${workspaceFolder}/buildgame",
            "args": [
                "-run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
